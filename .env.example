# Copy this file to .env and set values for the active contract.
CONTRACT=vandenendeIT
CONTRACT_EMAIL=
CONTRACT_ART_USER=

# Optional overrides when the contract's KeePass files do not follow the default names.
# CONTRACT_KEEPASS_DATABASE=
# CONTRACT_KEEPASS_KEY=

# Optional OpenShift login settings used by system/openshift.zsh.
OPENSHIFT_API_SERVER=
OPENSHIFT_LOGIN_CONTEXT=
OPENSHIFT_SA_CONTEXT=
OPENSHIFT_SA_SECRET=
OPENSHIFT_SA_NAMESPACE=
OPENSHIFT_SA_TOKEN_SERVICE=SA_TOKEN
